{
  "name": "@pmwdigital/efatura",
  "version": "0.1.0",
  "description": "e-Fatura ve e-Arşiv fatura XML'ini (UBL-TR) XSLT olmadan okur; kalemleri, KDV dökümünü ve toplamları verir",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmwdigital/pmw-efatura.git"
  },
  "keywords": [
    "e-fatura",
    "e-arsiv",
    "ubl-tr",
    "ubl",
    "gib",
    "ettn",
    "kdv",
    "xml",
    "xslt"
  ]
}
